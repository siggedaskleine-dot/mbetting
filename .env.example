# Lokalt räcker det med en fil. I molnet: libsql://<din-databas>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Slumpa fram med: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# E-postadressen som blir admin när den registreras (flera separeras med komma)
ADMIN_EMAIL=

# Google-inloggning (valfritt). Skapas i Google Cloud Console, se PUBLICERA.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
